---
import QRCode from 'qrcode';

interface Props {
  url: string;
  alt: string;
}
const { url, alt } = Astro.props;
const svg = await QRCode.toString(url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1e1e1e', light: '#0000' } });
---

<div class="qr" role="img" aria-label={alt} set:html={svg} />
