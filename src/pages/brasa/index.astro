---
import '@fontsource/big-shoulders/latin-900.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/gloock/latin-400.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/hanken-grotesk/latin-600.css';
import '@fontsource/hanken-grotesk/latin-700.css';
import '@fontsource/doto/latin-900.css';
import '../../styles/brasa.css';
import { CLUB } from '../../config';
import { CATEGORIAS, EVENTO, SESIONES, abreA } from '../../data/brasa';

// "Brasa, humo o chicha": valorar las charlas de un evento. Tiene estética propia.
const titulo = 'Brasa, humo o chicha';
const descripcion = `Ponle un sello a cada charla del ${EVENTO.nombre}: brasa, humo o chicha.`;
const canonica = new URL('/brasa/', Astro.site).href;
const fechaEvento = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(`${EVENTO.dia}T00:00:00Z`));
const hayPrograma = SESIONES.length > 0;
const orden = ['chicha', 'humo', 'brasa'] as const;
const sesiones = SESIONES.map((s) => ({ ...s, abre: abreA(s) }));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · {CLUB.nombre}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta name="theme-color" content="#d7b98a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="asador">
    <!-- tinta irregular de los sellos -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="tinta">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" result="r"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="r" scale="2.2"></feDisplacementMap>
      </filter>
    </svg>

    <div class="mesa">
      <header class="rotulo">
        <p class="rotulo-sobre">{EVENTO.nombre} · {EVENTO.lugar} · {fechaEvento}</p>
        <h1>
          <span class="p-brasa">
            Brasa,
            <span class="ascuas" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
          </span>
          <span class="p-humo">
            humo
            <svg class="volutas" viewBox="0 0 300 60" preserveAspectRatio="none" aria-hidden="true">
              <path d="M40 58c-14-12 14-20 0-32s12-18 2-26"></path>
              <path d="M150 58c-12-14 16-18 2-32s10-16 0-26"></path>
              <path d="M255 58c-14-12 12-22-2-34s14-16 4-24"></path>
            </svg>
          </span>
          <span class="p-chicha"><span class="o">o</span>chicha</span>
        </h1>
        <p class="rotulo-bajo">Cuando una charla va acabando, le pones un sello y cuentas por qué. La hora la apunta la máquina.</p>
      </header>

      <form class="comanda" id="comanda" novalidate>
        <div class="cabecera">
          <b>Comanda</b>
          {CLUB.nombre}
          <span class="reloj" id="reloj" aria-hidden="true">--:--:--</span>
        </div>

        <hr class="corte" />

        <fieldset class="paso">
          <legend><span>1</span>A nombre de</legend>
          <div class="dos-campos">
            <div>
              <label class="solo-lectores" for="nombre">Nombre y apellidos</label>
              <input type="text" id="nombre" name="nombre" autocomplete="name" maxlength="80" placeholder="Nombre y apellidos" required />
            </div>
            <div>
              <label class="solo-lectores" for="correo">Correo de la universidad</label>
              <input type="email" id="correo" name="correo" autocomplete="email" inputmode="email" autocapitalize="off" maxlength="120" placeholder="Correo de la universidad" required />
            </div>
          </div>
        </fieldset>

        <hr class="corte" />

        {
          hayPrograma ? (
            <fieldset class="paso">
              <legend>
                <span>2</span>La charla
              </legend>
              <div class="carta" id="carta">
                {sesiones.map((s) => (
                  <label data-id={s.id} data-inicio={s.inicio} data-abre={s.abre} class="cerrada">
                    <input type="radio" name="sesion" value={s.id} disabled />
                    <span class="hora">{s.inicio}</span>
                    <span class="plato">
                      {s.titulo}
                      {s.ponentes.length > 0 && <span class="quien">{s.ponentes.join(' · ')}</span>}
                      <span class="estado" />
                    </span>
                  </label>
                ))}
                <label>
                  <input type="radio" name="sesion" value="otra" />
                  <span class="hora">··:··</span>
                  <span class="plato">Otra que no está en la lista</span>
                </label>
              </div>
              <div id="caja-otra" hidden style="margin-top:.6rem">
                <label class="solo-lectores" for="titulo">Título de la charla</label>
                <input type="text" id="titulo" name="titulo" maxlength="160" placeholder="Título de la charla o quién la da" />
              </div>
            </fieldset>
          ) : (
            <div class="paso">
              <label class="etiqueta" for="titulo">
                <span>2</span>La charla
              </label>
              <input type="text" id="titulo" name="titulo" maxlength="160" placeholder="Título de la charla o quién la da" required />
            </div>
          )
        }

        <hr class="corte" />

        <fieldset class="paso">
          <legend>
            <span>3</span>El sello
          </legend>
          <div class="sellos">
            {
              orden.map((c) => (
                <label class={`sello-${c}`}>
                  <input type="radio" name="categoria" value={c} />
                  {c === 'chicha' && (
                    <svg class="dib-chicha" viewBox="0 0 64 64" aria-hidden="true">
                      <path d="M10 30c0-13 11-21 24-20 13 1 22 9 21 21-1 10-8 14-16 15-6 1-9 6-15 6-9 0-14-10-14-22z" fill="currentColor" />
                      <path d="M24 22h18M33 22v17" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" />
                    </svg>
                  )}
                  {c === 'humo' && (
                    <svg class="dib-humo" viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
                      <path d="M16 58c-8-9 8-13 0-22s8-13 2-22" />
                      <path d="M32 58c-8-9 8-13 0-22s8-13 2-24" />
                      <path d="M48 58c-8-9 8-13 0-22s8-13 2-20" />
                    </svg>
                  )}
                  {c === 'brasa' && (
                    <svg class="dib-brasa" viewBox="0 0 64 64" aria-hidden="true">
                      <path class="llama" d="M22 40c-6-9 2-14 0-24 8 5 12 12 9 24z" fill="currentColor" />
                      <path class="llama" d="M36 40c-5-11 4-17 3-30 10 8 14 19 8 30z" fill="currentColor" />
                      <path d="M6 44l10-5 12 3 10-4 12 4 8 7-6 9H12z" fill="currentColor" />
                      <path d="M17 49l8 2M34 46l9 3M26 55l12-1" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
                    </svg>
                  )}
                  <span>
                    <span class="nombre">{CATEGORIAS[c].nombre}</span>
                    <span class="que">{CATEGORIAS[c].definicion}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        {
          EVENTO.conNota && (
            <>
              <hr class="corte" />
              <fieldset class="paso">
                <legend>
                  <span>4</span>¿La repetirías?
                </legend>
                <div class="punto">
                  {[1, 2, 3, 4, 5].map((n) => (
                    <label>
                      <input type="radio" name="nota" value={n} />
                      {n}
                    </label>
                  ))}
                </div>
                <div class="extremos">
                  <span>Ni atado</span>
                  <span>Mañana mismo</span>
                </div>
              </fieldset>
            </>
          )
        }

        <hr class="corte" />

        <div class="paso">
          <label class="etiqueta" for="comentario">
            <span>{EVENTO.conNota ? 5 : 4}</span>Y por qué
          </label>
          <textarea id="comentario" name="comentario" maxlength="600" required placeholder="Qué te ha gustado, qué te ha sobrado, con qué te quedas"></textarea>
          <p class="cuenta" id="cuenta" aria-live="polite"></p>
        </div>

        <!-- campo trampa para bots: las personas no lo ven -->
        <div class="solo-lectores" aria-hidden="true">
          <label>No rellenar <input type="text" name="brasa_extra" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other" /></label>
        </div>

        <p class="fallo" id="fallo" role="alert" hidden></p>
        <p class="fallo" id="cerrada" hidden>La cocina ya está cerrada: no se admiten más comandas. Gracias por participar.</p>
        <button class="marchando" id="enviar" type="submit" disabled>Cargando…</button>
        <p class="letra-pequena">
          Al enviar se guardan tu nombre, tu correo, la charla, el sello, la nota, tu comentario y la hora exacta del servidor. Solo los ve el club. <a href="/aviso-legal/">Más detalle</a>.
        </p>
      </form>

      <section aria-labelledby="t-recibos" id="bloque-recibos" hidden>
        <h2 class="titulo-bloque" id="t-recibos">Tus comandas</h2>
        <ol class="recibos" id="recibos" aria-live="polite"></ol>
      </section>

      {
        hayPrograma && (
          <section aria-labelledby="t-parrilla" id="bloque-parrilla">
            <h2 class="titulo-bloque" id="t-parrilla">La parrilla, en directo</h2>
            <p class="directo">
              <span class="vivo" aria-hidden="true" />
              <span id="recuento">Esperando comandas</span>
            </p>
            <div class="orden" role="group" aria-label="Ordenar la clasificación por">
              {orden.map((c) => (
                <button type="button" class={`sello-${c} t-${c}`} data-orden={c} aria-pressed={c === 'chicha' ? 'true' : 'false'}>
                  {CATEGORIAS[c].nombre}
                </button>
              ))}
            </div>
            <ol class="parrilla" id="parrilla" />
            <p class="nada" id="nada">Todavía no ha salido ninguna comanda.</p>
          </section>
        )
      }

      <footer class="pie-asador">
        <p>
          Una actividad del <a href="/">{CLUB.nombre}</a>, club de estudiantes de la {CLUB.afiliacion}.
        </p>
      </footer>
    </div>

    <script type="application/json" id="datos" set:html={JSON.stringify({ evento: EVENTO, sesiones, categorias: CATEGORIAS })} />

    <script>
      type Cat = 'brasa' | 'humo' | 'chicha';
      interface Recibo {
        numero: number;
        hora: string;
        sesion: string;
        titulo: string;
        categoria: Cat;
      }
      type Cuenta = Record<Cat, number>;

      const datos = JSON.parse(document.getElementById('datos')!.textContent!);
      const CATS: Cat[] = ['chicha', 'humo', 'brasa'];
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const form = $<HTMLFormElement>('comanda');
      const nombre = $<HTMLInputElement>('nombre');
      const correo = $<HTMLInputElement>('correo');
      const comentario = $<HTMLTextAreaElement>('comentario');
      const titulo = document.getElementById('titulo') as HTMLInputElement | null;
      const cajaOtra = document.getElementById('caja-otra');
      const fallo = $('fallo');
      const boton = $<HTMLButtonElement>('enviar');
      const MIN = datos.evento.comentarioMin as number;

      // Guardar en el móvil es una comodidad: si el navegador no deja, todo sigue funcionando.
      const guardar = (clave: string, valor: string) => {
        try {
          localStorage.setItem(clave, valor);
        } catch {}
      };
      const leer = (clave: string) => {
        try {
          return localStorage.getItem(clave);
        } catch {
          return null;
        }
      };

      nombre.value = leer('brasa:nombre') ?? '';
      correo.value = leer('brasa:correo') ?? '';
      const recibos: Recibo[] = JSON.parse(leer('brasa:recibos') ?? '[]');

      // ---- la hora: se sigue la del servidor (llega con el marcador), no la del móvil
      let desfase = 0;
      let todoAbierto = false;
      let cerrada = false;
      let sincronizado = false;
      const partesMadrid = () => {
        const p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' }).formatToParts(new Date(Date.now() + desfase));
        const v = (t: string) => p.find((x) => x.type === t)!.value;
        return { dia: `${v('year')}-${v('month')}-${v('day')}`, reloj: `${v('hour')}:${v('minute')}:${v('second')}`, minutos: Number(v('hour')) * 60 + Number(v('minute')) };
      };
      const aMinutos = (hhmm: string) => Number(hhmm.slice(0, 2)) * 60 + Number(hhmm.slice(3, 5));

      // ---- estado de cada charla: cerrada, en curso, abierta, ya valorada
      let primeraPasada = true;
      function tictac() {
        const ahora = partesMadrid();
        $('reloj').textContent = ahora.reloj;
        const esElDia = ahora.dia === datos.evento.dia;
        const yaPaso = ahora.dia > datos.evento.dia;
        document.querySelectorAll<HTMLLabelElement>('#carta label[data-id]').forEach((fila) => {
          const abre = aMinutos(fila.dataset.abre!);
          const porHora = esElDia && ahora.minutos >= abre;
          if (porHora && sincronizado) fila.dataset.abierta = '1';
          const abierta = !cerrada && (todoAbierto || yaPaso || porHora || fila.dataset.abierta === '1');
          const enCurso = esElDia && !abierta && ahora.minutos >= aMinutos(fila.dataset.inicio!);
          const entrada = fila.querySelector('input')!;
          const estabaCerrada = fila.classList.contains('cerrada');
          fila.classList.toggle('cerrada', !abierta);
          fila.classList.toggle('en-curso', enCurso);
          if (abierta && estabaCerrada && !primeraPasada) fila.classList.add('recien');
          entrada.disabled = !abierta;
          const hecha = recibos.filter((r) => r.sesion === fila.dataset.id).pop();
          const estado = fila.querySelector('.estado')!;
          estado.textContent = hecha
            ? `Ya le pusiste ${datos.categorias[hecha.categoria].nombre.toLowerCase()}. Puedes cambiarlo.`
            : abierta
              ? ''
              : cerrada
                ? ''
                : enCurso
                  ? `En curso. Se abre a las ${fila.dataset.abre}`
                  : esElDia
                    ? `Se abre a las ${fila.dataset.abre}`
                    : `Se abre el día del foro a las ${fila.dataset.abre}`;
        });
        // cerrada la actividad, no se puede enviar nada (tampoco "otra charla")
        $('cerrada').hidden = !cerrada;
        boton.hidden = cerrada;
        const otra = form.querySelector<HTMLInputElement>('input[name="sesion"][value="otra"]');
        if (otra) otra.disabled = cerrada;
        primeraPasada = false;
      }
      tictac();
      setInterval(tictac, 1000);

      // ---- la opción elegida se marca con una clase; así funciona también en móviles antiguos
      function marcar() {
        form.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((i) => i.closest('label')?.classList.toggle('marcada', i.checked));
        form.querySelector('.sellos')?.classList.toggle('con-eleccion', Boolean(form.querySelector('.sellos input:checked')));
      }

      // ---- "otra charla"
      form.addEventListener('change', (e) => {
        marcar();
        const t = e.target as HTMLInputElement;
        if (t.name === 'sesion' && cajaOtra) {
          cajaOtra.hidden = t.value !== 'otra';
          if (t.value === 'otra') titulo?.focus();
        }
      });

      // ---- contador del comentario
      function contar() {
        const faltan = MIN - comentario.value.trim().length;
        $('cuenta').textContent = faltan > 0 ? `Faltan ${faltan} letras` : '';
      }
      comentario.addEventListener('input', contar);
      contar();

      // ---- recibos
      function pintarRecibo(r: Recibo, nuevo: boolean) {
        const li = document.createElement('li');
        li.className = 'recibo' + (nuevo ? ' nuevo' : '');
        const [dia, reloj] = r.hora.split(' ');
        const trozo = (clase: string, texto: string) => {
          const s = document.createElement('span');
          s.className = clase;
          s.textContent = texto;
          return s;
        };
        li.append(
          trozo('num', `Comanda n.º ${String(r.numero).padStart(4, '0')} · ${dia.split('-').reverse().join('/')}`),
          trozo('cuando', reloj),
          trozo('charla', r.titulo),
          trozo(`tampon t-${r.categoria}`, datos.categorias[r.categoria].nombre),
        );
        $('recibos').prepend(li);
        $('bloque-recibos').hidden = false;
        return li;
      }
      recibos.forEach((r) => pintarRecibo(r, false));

      // ---- la parrilla: clasificación en directo, reordenable
      const lista = document.getElementById('parrilla');
      const filas = new Map<string, HTMLLIElement>();
      let cuentas: Record<string, Cuenta> = {};
      let criterio: Cat = 'chicha';
      const total = (c: Cuenta) => c.chicha + c.humo + c.brasa;

      function pintarParrilla() {
        if (!lista) return;
        const conVotos = datos.sesiones.filter((s: { id: string }) => cuentas[s.id] && total(cuentas[s.id]) > 0);
        const ordenadas = [...conVotos].sort((a, b) => {
          const ca = cuentas[a.id];
          const cb = cuentas[b.id];
          return cb[criterio] / total(cb) - ca[criterio] / total(ca) || cb[criterio] - ca[criterio] || total(cb) - total(ca);
        });
        const antes = new Map([...filas].map(([id, li]) => [id, li.getBoundingClientRect().top]));

        ordenadas.forEach((s, i) => {
          const c = cuentas[s.id];
          let li = filas.get(s.id);
          if (!li) {
            li = document.createElement('li');
            li.innerHTML = '<span class="pos"></span><span class="charla"></span><div class="barra" role="img"><span class="b-chicha"></span><span class="b-humo"></span><span class="b-brasa"></span></div><span class="dato"></span>';
            li.querySelector('.charla')!.textContent = s.titulo;
            filas.set(s.id, li);
          }
          li.querySelector('.pos')!.textContent = String(i + 1);
          for (const cat of CATS) {
            const tramo = li.querySelector<HTMLElement>(`.b-${cat}`)!;
            tramo.style.flexGrow = String(c[cat]);
            tramo.textContent = c[cat] ? String(c[cat]) : '';
          }
          const pct = Math.round((100 * c[criterio]) / total(c));
          li.querySelector('.barra')!.setAttribute('aria-label', `Chicha ${c.chicha}, humo ${c.humo}, brasa ${c.brasa}`);
          li.querySelector('.dato')!.textContent = `${pct} % ${criterio} · ${total(c)} ${total(c) === 1 ? 'comanda' : 'comandas'}`;
          lista.append(li);
        });

        // las filas que cambian de puesto se deslizan hasta su sitio
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          ordenadas.forEach((s) => {
            const li = filas.get(s.id)!;
            const previa = antes.get(s.id);
            const dy = previa === undefined ? 0 : previa - li.getBoundingClientRect().top;
            if (previa === undefined) li.animate([{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'none' }], { duration: 400, easing: 'ease-out' });
            else if (Math.abs(dy) > 1) li.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], { duration: 520, easing: 'cubic-bezier(.2,.8,.2,1)' });
          });
        }
        $('nada').hidden = ordenadas.length > 0;
      }

      document.querySelectorAll<HTMLButtonElement>('.orden button').forEach((b) =>
        b.addEventListener('click', () => {
          criterio = b.dataset.orden as Cat;
          document.querySelectorAll('.orden button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          pintarParrilla();
        }),
      );

      async function marcador() {
        if (document.hidden) return;
        try {
          const res = await fetch('/api/brasa/votos/', { headers: { Accept: 'application/json' } });
          if (!res.ok) return;
          const m = await res.json();
          // la respuesta puede venir guardada unos segundos en la red de Vercel: se le suma su antigüedad
          const edad = Number(res.headers.get('age') ?? 0) * 1000;
          desfase = new Date(m.ahora).getTime() + (Number.isFinite(edad) ? edad : 0) - Date.now();
          todoAbierto = Boolean(m.todoAbierto);
          cerrada = Boolean(m.cerrada);
          sincronizado = true;
          cuentas = m.sesiones;
          if (lista) {
            $('recuento').textContent = m.total ? `${m.total} ${m.total === 1 ? 'comanda' : 'comandas'} en la parrilla` : 'Esperando comandas';
            pintarParrilla();
          }
        } catch {}
      }
      marcador();
      setInterval(marcador, 20000);
      document.addEventListener('visibilitychange', marcador);

      // ---- enviar
      function avisar(texto: string, campo?: HTMLElement | null) {
        fallo.textContent = texto;
        fallo.hidden = false;
        (campo ?? fallo).scrollIntoView({ block: 'center' });
        campo?.focus();
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        fallo.hidden = true;
        const f = new FormData(form);
        const cuerpo = {
          nombre: String(f.get('nombre') ?? '').trim(),
          correo: String(f.get('correo') ?? '').trim().toLowerCase(),
          sesion: String(f.get('sesion') ?? (datos.sesiones.length ? '' : 'otra')),
          titulo: String(f.get('titulo') ?? '').trim(),
          categoria: String(f.get('categoria') ?? ''),
          nota: f.get('nota') ?? '',
          comentario: String(f.get('comentario') ?? '').trim(),
          brasa_extra: String(f.get('brasa_extra') ?? ''),
        };
        if (cuerpo.nombre.length < 5 || !cuerpo.nombre.includes(' ')) return avisar('Escribe tu nombre y apellidos.', nombre);
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(cuerpo.correo)) return avisar('Escribe tu correo de la universidad.', correo);
        if (!cuerpo.sesion) return avisar('Elige la charla. Las que aún no van por el final están cerradas.', document.querySelector<HTMLElement>('#carta input:not(:disabled)'));
        if (cuerpo.sesion === 'otra' && cuerpo.titulo.length < 4) return avisar('Di qué charla es.', titulo);
        if (!cuerpo.categoria) return avisar('Falta el sello: brasa, humo o chicha.', form.querySelector<HTMLElement>('input[name="categoria"]'));
        if (cuerpo.comentario.length < MIN) return avisar(`El comentario es obligatorio: al menos ${MIN} letras.`, comentario);

        boton.disabled = true;
        boton.textContent = 'Apuntando…';
        // con la red del auditorio saturada, a los 20 s se corta y se puede reintentar
        const corte = new AbortController();
        const temporizador = setTimeout(() => corte.abort(), 20000);
        try {
          const res = await fetch('/api/brasa/votos/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo), signal: corte.signal });
          const r = await res.json().catch(() => ({}));
          if (!res.ok || !r.hora) return avisar(r.error ?? 'No ha llegado respuesta. Vuelve a pulsar «¡Marchando!»: si ya se había guardado, cuenta solo la última.');
          guardar('brasa:nombre', cuerpo.nombre);
          guardar('brasa:correo', cuerpo.correo);
          const recibo: Recibo = { numero: r.numero, hora: r.hora, sesion: r.sesion, titulo: r.titulo, categoria: r.categoria };
          recibos.push(recibo);
          guardar('brasa:recibos', JSON.stringify(recibos.slice(-40)));
          // se limpia todo menos quién eres, listo para la siguiente charla
          form.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((i) => (i.checked = false));
          comentario.value = '';
          if (titulo) titulo.value = '';
          if (cajaOtra) cajaOtra.hidden = true;
          marcar();
          contar();
          tictac();
          pintarRecibo(recibo, true).scrollIntoView({ block: 'center', behavior: 'smooth' });
          marcador();
          setTimeout(marcador, 12000);
        } catch {
          avisar('No ha llegado respuesta. Vuelve a pulsar «¡Marchando!»: si ya se había guardado, cuenta solo la última.');
        } finally {
          clearTimeout(temporizador);
          boton.disabled = false;
          boton.textContent = '¡Marchando!';
        }
      });

      // si el navegador restaura la pestaña (al volver de WhatsApp o de la cámara), se repinta lo que ya estaba elegido
      window.addEventListener('pageshow', () => {
        marcar();
        contar();
        const elegida = form.querySelector<HTMLInputElement>('input[name="sesion"]:checked');
        if (cajaOtra) cajaOtra.hidden = !(elegida && elegida.value === 'otra');
      });

      // todo listo: se enciende el botón
      boton.disabled = false;
      boton.textContent = '¡Marchando!';
    </script>
  </body>
</html>
