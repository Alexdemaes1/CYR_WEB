# Copia este fichero como .env para probar en local. En Vercel se ponen en
# Settings > Environment Variables (las dos de la base de datos las añade Vercel sola
# al conectar Upstash Redis desde la pestaña Storage).

# Dirección pública de la web, sin barra final
SITE_URL=

# Clave del panel privado de "Brasa, humo o chicha" (/brasa/panel/). Larga y solo tuya.
BRASA_CLAVE=

# Desbloquea todas las charlas y anula el cierre. Para pruebas, o de emergencia si el horario
# del evento se descuadra del todo.
# BRASA_ABIERTO=1

# Solo en local: finge la hora del servidor para probar los horarios.
# BRASA_AHORA=2026-11-20T10:50:00Z

# Base de datos de las valoraciones (Upstash Redis). En local, si faltan,
# las valoraciones se guardan en .datos/brasa.jsonl
KV_REST_API_URL=
KV_REST_API_TOKEN=
